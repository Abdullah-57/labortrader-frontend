# Frontend experiment extract — no database or provider credentials required.

# Public origin used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep true while experimenting so pages stay noindex.
SITE_INDEXING_DISABLED=true

# Show sample signup counters on marketing pages (stub data, not real).
FEATURE_PUBLIC_COUNTERS=true
PUBLIC_COUNTER_DISPLAY_MINIMUM=1

# Leave blank locally — forms skip reCAPTCHA when unset.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Admin UI is hidden unless you set a non-disabled mode (optional).
# ADMIN_AUTH_MODE=disabled
